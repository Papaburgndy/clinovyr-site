{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "clinovyr-site",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clinovyr-site"
    },
    {
      "binding": "DELIVERABLES",
      "service": "clinovyr-deliverables"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Custom build runs before deploy on Workers Builds (`npx wrangler deploy`).
  // Also deploys clinovyr-deliverables in CI so the DELIVERABLES binding exists.
  // See CLOUDFLARE-BUILD-SETTINGS.md Option D.
  "build": {
    "command": "node scripts/cloudflare-build.js"
  }
}
