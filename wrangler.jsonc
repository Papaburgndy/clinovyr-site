{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "clinovyr-site",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clinovyr-site"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Used by local `wrangler deploy` only. Workers Builds Git CI ignores this when
  // deploy is `npx wrangler deploy` (OpenNext hijacks). Set dashboard Build/Deploy
  // per CLOUDFLARE-BUILD-SETTINGS.md — do not leave Build command empty.
  "build": {
    "command": "npx prisma generate && npx opennextjs-cloudflare build"
  }
}
