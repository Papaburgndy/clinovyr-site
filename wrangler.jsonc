{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "clinovyr-site",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clinovyr-site"
    },
    {
      "binding": "DELIVERABLES",
      "service": "clinovyr-deliverables"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Custom build: OpenNext compile + deploy clinovyr-deliverables (OPEN_NEXT_DEPLOY=true).
  // Works with dashboard deploy command `npx wrangler deploy` — deliverables deploy here,
  // then wrangler/OpenNext deploys clinovyr-site with DELIVERABLES binding satisfied.
  // Alternative: `node scripts/cloudflare-deploy.js` (Option C in CLOUDFLARE-BUILD-SETTINGS.md).
  "build": {
    "command": "node scripts/cloudflare-build.js"
  }
}
