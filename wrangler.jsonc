{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "clinovyr-site",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "clinovyr-site"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DELIVERABLES_WORKER_URL": "https://clinovyr-deliverables.9dhr7chdr6.workers.dev"
  },
  // Custom build: OpenNext compile only (scripts/cloudflare-build.js).
  // Deploy clinovyr-deliverables from a separate Workers Builds — not from clinovyr-site CI
  // (WRANGLER_CI_OVERRIDE_NAME forces all wrangler deploy calls to clinovyr-site).
  // Main site calls deliverables via HTTP (DELIVERABLES_WORKER_URL) — no service binding.
  "build": {
    "command": "node scripts/cloudflare-build.js"
  }
}
