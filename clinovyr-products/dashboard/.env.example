# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://app.clinovyr.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin access (can view all dashboards + /admin)
ADMIN_EMAIL=admin@clinovyr.com

# Email — production (Resend)
RESEND_API_KEY=
EMAIL_FROM=Clinovyr Dashboard <dashboard@clinovyr.com>

# Claude monthly report generation (optional — stubs without key)
ANTHROPIC_API_KEY=

# Bearer token for /api/cron/monthly-reports (Cloudflare cron or external scheduler)
CRON_SECRET=generate-with-openssl-rand-base64-32
