# Local dev: set keys in repo root .env.local (/Clinoyr/.env.local), not here.
# Symlink for Next.js: ln -sf ../../.env.local .env.local

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Admin access (can view all dashboards + /admin)
ADMIN_EMAIL=admin@clinovyr.com

# Email — production (Resend)
RESEND_API_KEY=
EMAIL_FROM=Clinovyr Dashboard <dashboard@clinovyr.com>

# Email — development (Nodemailer / Mailpit)
# EMAIL_SERVER_HOST=localhost
# EMAIL_SERVER_PORT=1025
# EMAIL_FROM=dashboard@clinovyr.local

# Claude monthly report generation (optional — stubs without key)
ANTHROPIC_API_KEY=

# Bearer token for /api/cron/monthly-reports (local testing / external scheduler)
CRON_SECRET=generate-with-openssl-rand-base64-32
