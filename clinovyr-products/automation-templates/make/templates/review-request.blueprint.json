{
  "name": "{{COMPANY_NAME}} - Review Request",
  "flow": [
    {
      "id": 1,
      "module": "{{CRM_TYPE}}:watchCompletedJobs",
      "version": 1,
      "parameters": {
        "connection": "{{CRM_TYPE}}",
        "apiKey": "{{API_KEY_CRM}}"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "tools:Sleep",
      "version": 1,
      "parameters": {
        "delay": 172800
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      }
    },
    {
      "id": 3,
      "module": "{{EMAIL_PROVIDER}}:sendEmail",
      "version": 1,
      "parameters": {
        "to": "{{client.email}}",
        "subject": "How was your experience with {{COMPANY_NAME}}?",
        "body": "We'd love your feedback. Leave a review here: {{reviewLink}}"
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        }
      }
    }
  ],
  "metadata": {
    "templateId": "review-request",
    "placeholders": [
      "{{COMPANY_NAME}}",
      "{{CRM_TYPE}}",
      "{{EMAIL_PROVIDER}}",
      "{{API_KEY_CRM}}"
    ]
  }
}
