    "Score 4-6 Warm": {
      "main": [
        [{ "node": "Enqueue Drip Campaign", "type": "main", "index": 0 }],
        [{ "node": "Auto-Reply Cold Lead", "type": "main", "index": 0 }]
      ]
    },
    "Enqueue Drip Campaign": {
      "main": [[{ "node": "Log to Google Sheets", "type": "main", "index": 0 }]]
    },
    "Auto-Reply Cold Lead": {
      "main": [[{ "node": "Log to Google Sheets", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "{{CLIENT_TIMEZONE}}"
  },
  "meta": {
