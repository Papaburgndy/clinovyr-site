# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/clinovyr"

# Auth.js v5 — AUTH_SECRET is preferred; NEXTAUTH_SECRET is also supported
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Production webhook URL: https://clinovyr.com/api/webhooks/stripe
# Legacy alias still works: /api/stripe/webhook
# Optional Stripe Price IDs (override placeholder price_xxx_* in products catalog)
STRIPE_PRICE_AUDIT="price_..."
STRIPE_PRICE_ASSESSMENT="price_..."
STRIPE_PRICE_SPRINT="price_..."

# Site URL (used for Stripe redirect URLs)
SITE_URL="http://localhost:3000"

# Calendly
CALENDLY_URL="https://calendly.com/clinovyr"

# Email (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Clinovyr <onboarding@resend.dev>"
RESEND_SANDBOX="true"
CONTACT_EMAIL="clinovyr@gmail.com"

# Admin panel (/admin) — must match the logged-in user's email
ADMIN_EMAIL="clinovyr@gmail.com"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Vercel Blob (deliverable file storage)
# Create token at vercel.com/dashboard/stores — production on Cloudflare may migrate to R2
BLOB_READ_WRITE_TOKEN=

# Optional (if using Stripe.js on client)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
